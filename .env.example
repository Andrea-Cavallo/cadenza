# LLM Provider API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Ollama (if using local models)
OLLAMA_HOST=http://localhost:11434

# Cost tracking (optional, per million tokens)
LLMIDI_INPUT_COST_PER_MTK=3.00
LLMIDI_OUTPUT_COST_PER_MTK=15.00

# Cache directory (optional, defaults to ~/.cache/llmidi-gen/)
LLMIDI_CACHE_DIR=

# Prompts directory (optional, defaults to ./prompts/)
LLMIDI_PROMPTS_DIR=
